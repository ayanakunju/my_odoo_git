<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//block[@name='users_setting_container']"
                   position="after">
                <block title="Quiz Timer" id="quiz_timer">
                     <setting>
                        <div>
                            <label class="col-lg-3" string="Idle Time" for="idle_time"/>
                            <field name="idle_time" widget="float_time" class="oe_inline"/>minutes
                        </div>
                    </setting>
                    <setting>
                        <div>
                            <label class="col-log-3" string="Redirect Timer" for="idle_seconds" invisible="True"/> &#160;
                            <field name="idle_seconds" invisible="True" class="oe_inline"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>